# PostgreSQL + pgvector
DATABASE_URL=postgresql://raglab:raglab-dev-only@localhost:55432/raglab
DATABASE_CONNECT_TIMEOUT=3
API_HOST=127.0.0.1
API_PORT=8000

# flag: 실제 BGE, hash: 테스트용 임베딩
EMBEDDING_PROVIDER=flag
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false

CHUNK_SIZE=1600
CHUNK_OVERLAP=240
RETRIEVAL_TOP_K=5
MAX_UPLOAD_BYTES=20971520

# Ollama 채팅 API, 비우면 검색 전용
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b
LLM_TIMEOUT_SECONDS=60

# 외부 공개 전 API 키 설정
# RAG_LAB_API_KEY=change-me
