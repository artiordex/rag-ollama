# PostgreSQL with the pgvector extension
DATABASE_URL=postgresql://raglab:raglab-dev-only@localhost:55432/raglab
DATABASE_CONNECT_TIMEOUT=3

# flag = real BGE embeddings, hash = deterministic smoke-test embeddings
EMBEDDING_PROVIDER=flag
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false

CHUNK_SIZE=1600
CHUNK_OVERLAP=240
RETRIEVAL_TOP_K=5
MAX_UPLOAD_BYTES=20971520

# Ollama's OpenAI-compatible chat endpoint. Leave blank for retrieval-only mode.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b

# Set this before exposing the API outside localhost/VPN.
# RAG_LAB_API_KEY=change-me
