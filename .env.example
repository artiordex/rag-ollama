# PostgreSQL + pgvector
DATABASE_URL=postgresql://raglab:raglab-dev-only@localhost:55432/raglab
DATABASE_CONNECT_TIMEOUT=3
API_HOST=127.0.0.1
API_PORT=8000

# flag: 실제 BGE, hash: 테스트용 임베딩
EMBEDDING_PROVIDER=flag
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false

CHUNK_SIZE=1600
CHUNK_OVERLAP=240
RETRIEVAL_TOP_K=5
MAX_UPLOAD_BYTES=20971520

# Hugging Face Transformers 로컬 생성 모델
LLM_BACKEND=transformers
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
HF_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
HF_DEVICE_MAP=auto
HF_DTYPE=auto
HF_QUANTIZATION=none
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0
# gated 모델을 쓸 때만 Hugging Face 사용자 토큰 설정
# HF_TOKEN=

# Ollama 또는 vLLM과 비교할 때 선택하는 OpenAI 호환 백엔드
# LLM_BACKEND=openai-compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gpt-oss:20b
# LLM_TIMEOUT_SECONDS=60
# 검색 전용 모드: LLM_BACKEND=none

# 4bit 사용 전: uv sync --extra quantization
# HF_QUANTIZATION=4bit

# Hugging Face 캐시 위치를 바꾸고 싶을 때만 설정
# HF_HOME=/path/to/huggingface-cache

# 외부 공개 전 API 키 설정
# RAG_LAB_API_KEY=change-me
